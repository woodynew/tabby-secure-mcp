{
  "name": "@tabby-secure-mcp/ipc-contract",
  "version": "0.1.0",
  "description": "Shared IPC contract for tabby-secure-mcp",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.mts --root .",
    "test:integration": "vitest run --config ../../vitest.integration.config.mts --root .",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "7.0.2"
  }
}
