    "zod": "4.6.7",
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "private": true,
  "main": "dist/plugin.cjs",
  "types": "dist/plugin.d.ts"
}
