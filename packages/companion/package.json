{
  "name": "@tabby-secure-mcp/companion",
  "version": "0.1.1",
  "description": "Internal embedded MCP library for tabby-secure-mcp",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
