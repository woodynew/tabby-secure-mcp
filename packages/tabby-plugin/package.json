{
  "name": "tabby-secure-mcp",
  "version": "0.1.0",
  "description": "Tabby plugin for secure MCP SSH profile access with in-app approval",
  "author": "tabby-secure-mcp contributors",
  "license": "MIT",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "tabby-plugin"
  ],
  "scripts": {
    "build": "node build.cjs",
    "pretest": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.mts --root .",
    "test:integration": "vitest run --config ../../vitest.integration.config.mts --root .",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@angular/common": "15.2.10",
    "@angular/core": "15.2.10",
    "@angular/forms": "15.2.10",
    "@angular/localize": "15.2.10",
    "@ng-bootstrap/ng-bootstrap": "14.2.0",
    "rxjs": "7.8.2",
    "tabby-core": "1.0.231-nightly.0",
    "tabby-settings": "1.0.231-nightly.0"
  },
  "devDependencies": {
    "@tabby-secure-mcp/ipc-contract": "0.1.0",
    "@angular/compiler": "15.2.10",
    "@angular/compiler-cli": "15.2.10",
    "ts-loader": "9.6.2",
    "deep-equal": "2.2.3",
    "tslib": "2.8.1",
    "typescript": "4.9.5",
    "webpack": "5.111.1"
  }
}
