{
  "name": "tabby-secure-mcp-workspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/ipc-contract",
    "packages/companion",
    "packages/tabby-plugin"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:internal": "npm run build --workspace @tabby-secure-mcp/ipc-contract && npm run build --workspace @tabby-secure-mcp/companion",
    "pretypecheck": "npm run build:internal",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "pretest": "npm run build:internal",
    "pretest:scripts": "npm run build",
    "test:scripts": "vitest run --config vitest.scripts.config.mts",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "pretest:integration": "npm run build:internal",
    "pack:check": "node scripts/pack-check.mjs",
    "install:local": "node scripts/install-local.mjs"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "@types/node": "20.19.23",
    "ajv": {
      "fast-uri": "3.1.9"
    },
    "tabby-secure-mcp": {
      "typescript": "4.9.5"
    }
  }
}
